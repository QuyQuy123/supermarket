' 3.6 POS Transaction

@startuml
!include _style.puml
title 3.6 POS Transaction

class PosCheckoutController {
  + openShift(dto: PosDTO): PosDTO
  + scanProduct(dto: PosDTO): PosDTO
  + searchProduct(dto: PosDTO): PosDTO
  + updateCartItem(dto: PosDTO): PosDTO
  + registerMember(dto: PosDTO): PosDTO
  + applyDiscountCode(dto: PosDTO): PosDTO
  + issueInvoice(dto: PosDTO): PosDTO
  + closeShift(dto: PosDTO): PosDTO
}

interface IPosService {
  + openShift(dto: PosDTO): PosDTO
  + scanProduct(dto: PosDTO): PosDTO
  + searchProduct(dto: PosDTO): PosDTO
  + updateCartItem(dto: PosDTO): PosDTO
  + registerMember(dto: PosDTO): PosDTO
  + applyDiscountCode(dto: PosDTO): PosDTO
  + issueInvoice(dto: PosDTO): PosDTO
  + closeShift(dto: PosDTO): PosDTO
}

class PosServiceImpl {
  -posRepository: IPosRepository
}

interface IPosRepository {
  + findByKey(key: string): Entity
  + findAll(): List~Entity~
  + save(entity: Entity): Entity
}

class PosRepositoryImpl {
}

class PosDTO

class Entity

PosCheckoutController --> IPosService
PosServiceImpl ..|> IPosService
PosServiceImpl --> IPosRepository
PosRepositoryImpl ..|> IPosRepository

PosCheckoutController --> PosDTO

IPosService --> PosDTO

IPosRepository --> Entity

PosCheckoutController -[hidden]right- PosServiceImpl
PosServiceImpl -[hidden]right- PosRepositoryImpl
IPosService -[hidden]right- IPosRepository
PosDTO -[hidden]right- Entity

@enduml
