@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top

actor "Admin / Manager" as A
boundary "Products UI" as UI <<boundary>>
control "ProductController" as PC <<control>>
control "ProductService" as S <<service>>
entity "ProductRepository" as PR <<entity>>

== Add product ==
A -> UI: fill form + Save
activate UI
UI -> PC: POST /api/products\n(CreateProductRequest)
activate PC
PC -> S: createProduct(request)
activate S
S -> S: map category, supplier, stock
S -> PR: save(product)
activate PR
PR --> S: Product
deactivate PR
S --> PC: ProductDetailResponse
deactivate S
PC --> UI: 201 Created
deactivate PC
UI --> A: refresh list
deactivate UI

@enduml
