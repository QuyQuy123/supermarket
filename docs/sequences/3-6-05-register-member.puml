@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top
title 3.6.6 Register Member

actor "Cashier" as C
boundary "POS UI" as UI <<boundary>>
control "CustomerController" as CC <<control>>
control "CustomerService" as S <<service>>
entity "CustomerRepository" as R <<entity>>

== Register member ==
C -> UI: enter phone/name + Save
activate UI
UI -> CC: GET /api/customers/by-phone?phone=...
activate CC
CC -> S: getCustomerByPhone(phone)
activate S
S -> R: findByPhone(phone)
activate R
R --> S: Customer | null
deactivate R
alt found existing member
  S --> CC: CustomerListItemResponse
  CC --> UI: 200 existing customer
else not found
  CC -> S: createCustomer(request)
  S -> R: save(customer)
  R --> S: Customer
  S --> CC: CustomerListItemResponse
  CC --> UI: 200 new customer
end
deactivate S
deactivate CC
UI --> C: attach member + show loyalty/discount
deactivate UI

@enduml
