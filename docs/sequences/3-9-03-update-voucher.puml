@startuml
!include _seq-style.puml
title 3.9.4 UpdateVoucher

actor "Admin / Manager" as A
boundary "Discounts UI" as UI <<boundary>>
control "DiscountController" as DC <<control>>
control "DiscountService" as S <<service>>
entity "DiscountRepository" as R <<entity>>

== Update voucher ==
A -> UI: edit + Save
activate UI
UI -> DC: PUT /api/discounts/{id}\n(UpdateDiscountRequest)
activate DC
DC -> S: updateDiscount(id, request)
activate S
S -> R: findById + save
activate R
R --> S: Discount
deactivate R
S --> DC: DiscountResponse
deactivate S
DC --> UI: 200 JSON
deactivate DC
UI --> A: refresh table
deactivate UI

@enduml
