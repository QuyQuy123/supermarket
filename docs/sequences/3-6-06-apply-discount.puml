@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top
title 3.6.7 Apply Discount Code

actor "Cashier" as C
boundary "POS UI" as UI <<boundary>>
control "DiscountController" as DC <<control>>
control "DiscountService" as S <<service>>
entity "DiscountRepository" as R <<entity>>

== Apply discount code ==
C -> UI: enter voucher code
activate UI
UI -> DC: GET /api/discounts
activate DC
DC -> S: getAllDiscounts()
activate S
S -> R: findAll()
activate R
R --> S: List~Discount~
deactivate R
S --> DC: List~DiscountResponse~
deactivate S
DC --> UI: 200 JSON
deactivate DC
UI -> UI: filter valid discounts by date/minOrder
UI -> UI: choose best member discount\n(max(customer, loyalty))
UI -> UI: payable = subtotal * (1 - combinedPercent/100)
UI --> C: show discount + amount due
deactivate UI

@enduml
