@startuml
!include _seq-style.puml
title 3.1.4 ChangePassword

actor "User" as U
boundary "Profile / Settings UI" as UI <<boundary>>
control "UserController" as UC <<control>>
control "UserService" as S <<service>>
entity "UserRepository" as R <<entity>>

== Change password ==
U -> UI: enter current + new password
activate UI
UI -> UC: PUT /api/users/{id}/password\n(ChangePasswordRequest)
activate UC
UC -> S: changePassword(id, request)
activate S
S -> R: findById(id)
activate R
R --> S: User
deactivate R
S -> S: passwordEncoder.matches + encode(new)
S -> R: save(user)
activate R
R --> S: User
deactivate R
S --> UC: void
deactivate S
UC --> UI: 200 OK
deactivate UC
UI --> U: success / error message
deactivate UI

@enduml
