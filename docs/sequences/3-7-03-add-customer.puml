@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top

actor "User" as A
boundary "Customers UI" as UI <<boundary>>
control "CustomerController" as CC <<control>>
control "CustomerService" as S <<service>>
entity "CustomerRepository" as R <<entity>>

== Add customer ==
A -> UI: form + Save
activate UI
UI -> CC: POST /api/customers\n(CreateCustomerRequest)
activate CC
CC -> S: createCustomer(request)
activate S
S -> R: save(customer)
activate R
R --> S: Customer
deactivate R
S --> CC: CustomerListItemResponse
deactivate S
CC --> UI: 200 JSON
deactivate CC
UI --> A: add row
deactivate UI

@enduml
