@startuml
!include _seq-style.puml
title 3.4.3 ViewSupplierDetail

actor "Admin / Manager" as A
boundary "Suppliers UI" as UI <<boundary>>
control "SupplierController" as SC <<control>>
control "SupplierService" as S <<service>>
entity "SupplierRepository" as R <<entity>>

== Supplier detail ==
A -> UI: select supplier
activate UI
UI -> SC: GET /api/suppliers/{id}
activate SC
SC -> S: getSupplierById(id)
activate S
S -> R: findById(id)
activate R
R --> S: Supplier
deactivate R
S -> S: map response
S --> SC: SupplierListItemResponse
deactivate S
SC --> UI: 200 JSON
deactivate SC
UI --> A: show detail
deactivate UI

@enduml
