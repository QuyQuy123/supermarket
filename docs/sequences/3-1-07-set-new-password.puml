@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top


actor "User" as U
boundary "Reset password UI" as UI <<boundary>>
control "AuthController" as AC <<control>>
control "AuthService" as S <<service>>
entity "UserRepository" as UR <<entity>>
entity "PasswordResetTokenRepository" as TR <<entity>>

== Set new password ==
U -> UI: enter OTP + new password
activate UI
UI -> AC: POST /api/auth/reset-password\n?otp=&newPassword=
activate AC
AC -> S: resetPassword(otp, newPassword)
activate S
S -> TR: findByOtpAndExpiresAtAfter(...)
activate TR
TR --> S: PasswordResetToken
deactivate TR
S -> UR: findByUsernameIgnoreCaseOrEmailIgnoreCase(email)
activate UR
UR --> S: List~User~
deactivate UR
S -> S: encode password, update each User
S -> UR: save(user) (loop)
S -> TR: delete(token)
S --> AC: void
deactivate S
AC --> UI: 200 OK / 400
deactivate AC
UI --> U: message, go to Login
deactivate UI

@enduml
