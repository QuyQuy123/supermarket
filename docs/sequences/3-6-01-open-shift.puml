@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top
title 3.6.2 Open Shift

actor "Cashier" as C
boundary "POS UI" as UI <<boundary>>
control "ShiftSessionManager" as SM <<control>>

== Start shift ==
C -> UI: input opening cash + open shift
activate UI
UI -> SM: openShift(cashierId, openingCash)
activate SM
SM -> SM: validate no active shift
SM -> SM: create ShiftSession(openedAt, openingCash)
SM --> UI: ShiftSessionDTO
deactivate SM
UI --> C: show active shift + enable checkout
deactivate UI

@enduml
