@startuml
skinparam shadowing false
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
skinparam sequenceParticipant underline false
skinparam stereotypePosition top


actor "User" as A
boundary "Customers UI" as UI <<boundary>>
control "CustomerController" as CC <<control>>
control "CustomerService" as S <<service>>
entity "CustomerRepository" as R <<entity>>

== Customer list ==
A -> UI: open Customers
activate UI
UI -> CC: GET /api/customers
activate CC
CC -> S: getAllCustomers()
activate S
S -> R: findAll()
activate R
R --> S: List~Customer~
deactivate R
S -> S: map → CustomerListItemResponse
S --> CC: List~CustomerListItemResponse~
deactivate S
CC --> UI: 200 JSON
deactivate CC
UI --> A: customer table
deactivate UI

@enduml
